+#ifdef BB_WINDOWS
+// LLVM lowers roundeven to a libc call on baseline x64 (without SSE4.1).
+// The Windows CRT does not provide that C23 function. Keep ties-to-even
+// independent of the thread's floating-point rounding mode.
+extern "C" double roundeven(double value) {
+    if (!std::isfinite(value) || std::fabs(value) >= 4503599627370496.0) return value;
+    double result = std::floor(value);
+    const double fraction = value - result;
+    if (fraction > 0.5 || (fraction == 0.5 && std::fmod(result, 2.0) != 0.0)) result += 1.0;
+    return std::copysign(result, value);
+}
+extern "C" float roundevenf(float value) { return static_cast<float>(roundeven(value)); }
