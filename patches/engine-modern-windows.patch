+#include "../stdutil/stdutil.h"
+#include "filesystem.h"
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#ifdef BB_WINDOWS
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace fs=std::filesystem;
+namespace {
+fs::path saveRoot,saveStage;
+bool saving=false;
+
+void flushFile(const fs::path &path){
+#ifdef BB_WINDOWS
+    HANDLE h=CreateFileW(path.c_str(),GENERIC_WRITE,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);
+    if(h==INVALID_HANDLE_VALUE) throw std::runtime_error("Cannot flush save file");
+    bool ok=FlushFileBuffers(h)!=0;CloseHandle(h);
+    if(!ok) throw std::runtime_error("Cannot flush save file");
+#else
+    int fd=::open(path.c_str(),O_WRONLY);
+    if(fd<0) throw std::runtime_error("Cannot flush save file");
+    int result=fsync(fd);close(fd);
+    if(result) throw std::runtime_error("Cannot flush save file");
+#endif
+}
+void renamePath(const fs::path &from,const fs::path &to){
+#ifdef BB_WINDOWS
+    if(!MoveFileExW(from.c_str(),to.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))
+        throw std::runtime_error("Cannot commit save; check free space and folder permissions");
+#else
+    fs::rename(from,to);
+#endif
+}
+fs::path sibling(const fs::path &root,const char *suffix){ return fs::u8path(root.u8string()+suffix); }
+fs::path rootPath(const std::string &name){
+    fs::path root=fs::absolute(fs::u8path(name)).lexically_normal();
+    if(root==root.root_path() || root.filename().empty() || !fs::is_directory(root.parent_path()))
+        throw std::runtime_error("Invalid save directory");
+    for(const auto &path:{root,sibling(root,".saving"),sibling(root,".previous"),sibling(root,".transaction")})
+        if(fs::is_symlink(fs::symlink_status(path))) throw std::runtime_error("Save directories must not be links");
+    return root;
+}
+void checkTree(const fs::path &path){
+    if(!fs::exists(path)) return;
+    if(fs::is_symlink(fs::symlink_status(path))) throw std::runtime_error("Save recovery directory must not be a link");
+    for(const auto &entry:fs::recursive_directory_iterator(path))
+        if(entry.is_symlink() || (!entry.is_directory() && !entry.is_regular_file()))
+            throw std::runtime_error("Unsupported file in save directory");
+}
+void ownership(const fs::path &root){
+    const auto marker=sibling(root,".transaction");
+    // The installation is portable: moving its containing directory must not
+    // invalidate ownership of these fixed sibling recovery folders.
+    const std::string token="Hard Time save transaction v2\n"+root.filename().u8string()+"\n";
+    if(fs::exists(marker)){
+        std::ifstream input(marker,std::ios::binary);
+        std::string actual((std::istreambuf_iterator<char>(input)),{});
+        if(actual!=token) throw std::runtime_error("Unrecognized save transaction marker");
+    }else{
+        if(fs::exists(sibling(root,".saving")) || fs::exists(sibling(root,".previous")))
+            throw std::runtime_error("Unrecognized save recovery folder; preserve it before continuing");
+        std::ofstream output(marker,std::ios::binary);output<<token;output.close();
+        if(!output) throw std::runtime_error("Cannot create save transaction marker");
+        flushFile(marker);
+    }
+}
+void recover(const fs::path &root){
+    ownership(root);
+    const auto previous=sibling(root,".previous");
+    if(!fs::exists(root) && fs::is_directory(previous)) renamePath(previous,root);
+    if(!fs::is_directory(root)) throw std::runtime_error("Save directory is missing");
+}
+}
+
+std::string bbSavePath(const std::string &name){
+    if(!saving) return name;
+    const auto path=fs::absolute(fs::u8path(name)).lexically_normal();
+#ifdef BB_WINDOWS
+    const std::wstring prefix=fs::path(saveRoot).make_preferred().native()+L"\\";
+    const std::wstring full=fs::path(path).make_preferred().native();
+    if(full.size()<=prefix.size() || CompareStringOrdinal(full.c_str(),int(prefix.size()),prefix.c_str(),int(prefix.size()),TRUE)!=CSTR_EQUAL) return name;
+    fs::path relative(full.substr(prefix.size()));
+#else
+    auto relative=path.lexically_relative(saveRoot);
+#endif
+    if(relative.empty() || *relative.begin()=="..") return name;
+    return (saveStage/relative).u8string();
+}
+
+void bbCommitFile(const std::string &temporary,const std::string &target,bool backup){
+    try{
+        const auto source=fs::u8path(temporary),destination=fs::u8path(target);
+        flushFile(source);
+        if(backup && fs::is_regular_file(destination)){
+            const auto copy=sibling(destination,".bak.pending");
+            fs::copy_file(destination,copy,fs::copy_options::overwrite_existing);
+            flushFile(copy);renamePath(copy,sibling(destination,".bak"));
+        }
+        renamePath(source,destination);
+    }catch(const std::exception &e){ RTEX(e.what()); }
+}
+
+void BBCALL bbRecoverSaveTransaction(BBStr *directory){
+    std::string name=*directory;delete directory;
+    try{ recover(rootPath(name)); }catch(const std::exception &e){ RTEX(e.what()); }
+}
+void BBCALL bbBeginSaveTransaction(BBStr *directory){
+    std::string name=*directory;delete directory;
+    try{
+        if(saving) throw std::runtime_error("Save transaction already active");
+        saveRoot=rootPath(name);recover(saveRoot);checkTree(saveRoot);
+        saveStage=sibling(saveRoot,".saving");checkTree(saveStage);
+        // Siblings are resolved above, and ownership was checked before cleanup.
+        fs::remove_all(saveStage);
+        fs::copy(saveRoot,saveStage,fs::copy_options::recursive);
+        saving=true;
+    }catch(const std::exception &e){ RTEX(e.what()); }
+}
+void BBCALL bbCommitSaveTransaction(){
+    try{
+        if(!saving) throw std::runtime_error("No save transaction active");
+        for(const auto &entry:fs::recursive_directory_iterator(saveStage))
+            if(entry.is_regular_file()) flushFile(entry.path());
+        const auto previous=sibling(saveRoot,".previous");
+        checkTree(previous);fs::remove_all(previous);
+        renamePath(saveRoot,previous);
+        try{ renamePath(saveStage,saveRoot); }
+        catch(...){ renamePath(previous,saveRoot);throw; }
+        saving=false;saveRoot.clear();saveStage.clear();
+    }catch(const std::exception &e){ RTEX(e.what()); }
+}
