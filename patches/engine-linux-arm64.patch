+static std::shared_ptr<OpenALSample> loadSample(const std::string& filename,bool use3d){
+    std::vector<unsigned char> pcm;
+    SDL_AudioSpec spec={}; Uint8 *wav=0; Uint32 wavsize=0;
+    // SDL handles RIFF chunk ordering plus both MS-ADPCM and IMA-ADPCM,
+    // all of which occur in Hard Time's original assets.
+    if(SDL_LoadWAV(filename.c_str(),&spec,&wav,&wavsize)){
+        pcm.assign(wav,wav+wavsize); SDL_FreeWAV(wav);
+    }else{
+        std::unique_ptr<AudioStream> decoder;
+        std::string ext=filename.substr(filename.find_last_of('.')+1);
+        std::transform(ext.begin(),ext.end(),ext.begin(),[](unsigned char c){return std::tolower(c);});
+        if(ext=="ogg") decoder.reset(new OGGAudioStream(65536));
+        else if(ext=="mp3") decoder.reset(new MP3AudioStream(65536));
+        else return {};
+        if(!decoder->init(filename.c_str())) return {};
+        std::unique_ptr<AudioStream::Ref> ref(decoder->getRef());
+        spec.freq=ref->getFrequency(); spec.channels=ref->getChannels();
+        spec.format=ref->getBits()==8?AUDIO_U8:AUDIO_S16LSB;
+        for(;;){
+            unsigned char *bytes; size_t count=ref->decode(&bytes);
+            if(!count) break;
+            pcm.insert(pcm.end(),bytes,bytes+count);
+            if(pcm.size()>INT_MAX/8) return {};
+        }
+    }
+    if(pcm.empty()||spec.freq<=0||!spec.channels||pcm.size()>INT_MAX/8) return {};
+    int outputChannels=use3d?1:std::min(2,(int)spec.channels);
+    SDL_AudioCVT cvt={};
+    int convert=SDL_BuildAudioCVT(&cvt,spec.format,spec.channels,spec.freq,AUDIO_S16SYS,outputChannels,spec.freq);
+    if(convert<0) return {};
+    if(convert){
+        cvt.len=(int)pcm.size();
+        pcm.resize((size_t)cvt.len*cvt.len_mult); cvt.buf=pcm.data();
+        if(SDL_ConvertAudio(&cvt)<0) return {};
+        pcm.resize(cvt.len_cvt);
+    }
+    auto sample=std::make_shared<OpenALSample>();
+    sample->frequency=spec.freq; sample->channels=outputChannels;
+    sample->duration=pcm.size()/(2.0f*outputChannels*spec.freq);
+    alGetError(); alGenBuffers(1,&sample->buffer);
+    alBufferData(sample->buffer,outputChannels==1?AL_FORMAT_MONO16:AL_FORMAT_STEREO16,pcm.data(),(ALsizei)pcm.size(),spec.freq);
+    if(alGetError()!=AL_NO_ERROR) return {};
+    return sample;
+}
 
