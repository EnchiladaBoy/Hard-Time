-class NoopTimer : public BBTimer{
-protected:
-	int hertz;
+// Monotonic, cumulative timer matching Blitz WaitTimer catch-up semantics.
+class PosixTimer : public BBTimer {
+    using Clock = std::chrono::steady_clock;
+    Clock::time_point start;
+    long long ticks = 0;
+    int hertz;
 public:
-	NoopTimer( int h ):hertz(h){}
