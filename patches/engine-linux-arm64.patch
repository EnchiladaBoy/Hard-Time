-	}
+    explicit PosixTimer(int h): start(Clock::now()), hertz(h > 0 ? h : 1) {}
+    int wait() override {
+        const auto deadline = start + std::chrono::nanoseconds(
+            ((ticks + 1) * 1000000000LL + hertz - 1) / hertz);
+        std::this_thread::sleep_until(deadline);
+        const auto nanos = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
+        const long long elapsed = nanos * hertz / 1000000000LL;
+        const long long pending = elapsed - ticks;
+        const int result = static_cast<int>(pending > std::numeric_limits<int>::max() ? std::numeric_limits<int>::max() : pending);
+        ticks += result;
+        return result;
+    }
 };
 
