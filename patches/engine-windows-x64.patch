+
+void SDLGraphics::swap(){
+#ifdef BB_WINDOWS
+ // Preserve the completed BACK buffer before WGL swaps it. The desktop
+ // compositor does not guarantee readable FRONT pixels (occluded windows
+ // can return black), and the next BACK buffer can be discarded.
+ GLint readFramebuffer=0,drawFramebuffer=0,readBuffer=0,drawBuffer=0,renderbuffer=0;
+ glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&readFramebuffer);
+ glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&drawFramebuffer);
+ glGetIntegerv(GL_READ_BUFFER,&readBuffer);
+ glGetIntegerv(GL_DRAW_BUFFER,&drawBuffer);
+ glGetIntegerv(GL_RENDERBUFFER_BINDING,&renderbuffer);
+ const GLboolean scissor=glIsEnabled(GL_SCISSOR_TEST);
+ int width=0,height=0;
+ SDL_GL_GetDrawableSize(wnd,&width,&height);
+ if(width>0 && height>0){
+  if(!swapFramebuffer) glGenFramebuffers(1,&swapFramebuffer);
+  if(!swapColor) glGenRenderbuffers(1,&swapColor);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,swapFramebuffer);
+  if(width!=swapWidth || height!=swapHeight){
+   glBindRenderbuffer(GL_RENDERBUFFER,swapColor);
+   glRenderbufferStorage(GL_RENDERBUFFER,GL_RGBA8,width,height);
+   glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_RENDERBUFFER,swapColor);
+   swapWidth=width;swapHeight=height;
+  }
+  glDrawBuffer(GL_COLOR_ATTACHMENT0);
+  if(glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER)!=GL_FRAMEBUFFER_COMPLETE)
+   RTEX("Unable to preserve the Windows backbuffer");
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,0);glReadBuffer(GL_BACK);
+  glDisable(GL_SCISSOR_TEST);
+  glBlitFramebuffer(0,0,width,height,0,0,width,height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,0);glDrawBuffer(GL_BACK);
+  SDL_GL_SwapWindow(wnd);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,swapFramebuffer);glReadBuffer(GL_COLOR_ATTACHMENT0);
+  glBlitFramebuffer(0,0,width,height,0,0,width,height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+ }else{
+  SDL_GL_SwapWindow(wnd);
+ }
+ glBindRenderbuffer(GL_RENDERBUFFER,renderbuffer);
+ glBindFramebuffer(GL_READ_FRAMEBUFFER,readFramebuffer);glReadBuffer(readBuffer);
+ glBindFramebuffer(GL_DRAW_FRAMEBUFFER,drawFramebuffer);glDrawBuffer(drawBuffer);
+ if(scissor) glEnable(GL_SCISSOR_TEST);
+#else
+ SDL_GL_SwapWindow(wnd);
+#endif
 }
 
