+; Native Windows preferences. Legacy Options.dat and slot formats stay readable.
+Global nativeBorderless=0,nativeAppliedMode=-1,nativeAppliedRes=2,nativeHud=100
+Global nativeSensitivity=100,nativeDistance=100,nativeAutoPause=1
+Global nativeMusic=100,nativeEffects=100,nativeAmbience=100
+Global nativeUi=0,nativeFocused=1,nativeSettingsRecovered=0,nativeDiscardTicks=0
+Global nativeLogicStart=0,nativeUiStart=0,nativeLogicMs=0,nativeRenderMs=0,nativeUiMs=0,nativePresentMs=0
+Dim nativeKey(9),nativeKeyName$(9),nativeSetting(18)
+nativeKey(1)=200 : nativeKey(2)=208 : nativeKey(3)=203 : nativeKey(4)=205
+nativeKey(5)=30 : nativeKey(6)=44 : nativeKey(7)=31 : nativeKey(8)=45 : nativeKey(9)=25
+nativeKeyName$(1)="Move forward" : nativeKeyName$(2)="Move backward"
+nativeKeyName$(3)="Move left" : nativeKeyName$(4)="Move right"
+nativeKeyName$(5)="Attack / shoot" : nativeKeyName$(6)="Defend / run"
+nativeKeyName$(7)="Throw / grab" : nativeKeyName$(8)="Pick up / drop" : nativeKeyName$(9)="Pause"
+
+Function NativeClamp(value,low,high)
+ If value<low Then Return low
+ If value>high Then Return high
+ Return value
+End Function
+
+Function NativeValidKey(value)
+ If value<2 Or value>211 Then Return 0
+ If value=28 Or value=56 Or value=184 Or value=87 Or value=88 Then Return 0
+ Return 1
+End Function
+
+Function NativeSyncKeys()
+ keyAttack=nativeKey(5) : keyDefend=nativeKey(6)
+ keyThrow=nativeKey(7) : keyPickUp=nativeKey(8)
+End Function
+
+Function NativeKeyPreset(wasd)
+ nativeKey(1)=200 : nativeKey(2)=208 : nativeKey(3)=203 : nativeKey(4)=205
+ nativeKey(5)=30 : nativeKey(6)=44 : nativeKey(7)=31 : nativeKey(8)=45 : nativeKey(9)=25
+ If wasd
+  nativeKey(1)=17 : nativeKey(2)=31 : nativeKey(3)=30 : nativeKey(4)=32
+  nativeKey(5)=36 : nativeKey(6)=37 : nativeKey(7)=38 : nativeKey(8)=18
+ EndIf
+ NativeSyncKeys()
+End Function
+
+Function NativeValidOptions(path$)
+ Local size=FileSize(path$),stream,n,length,value,valid=1
+ If size<68 Or size>260 Then Return 0
+ stream=ReadFile(path$)
+ If stream=0 Then Return 0
+ For n=1 To 14
+  value=ReadInt(stream)
+  If n=1 And (value<0 Or value>5) Then valid=0
+  If n=2 And (value<40 Or value>100) Then valid=0
+  If n=3 And (value<0 Or value>1) Then valid=0
+  If (n=4 Or n=5) And (value<0 Or value>2) Then valid=0
+  If n=6 And (value<0 Or value>3) Then valid=0
+  If n>=7 And n<=10 And (value<1 Or value>255) Then valid=0
+  If n>=11 And (value<1 Or value>255) Then valid=0
+ Next
+ For n=1 To 3
+  If FilePos(stream)+4>size Then valid=0 : Exit
+  length=ReadInt(stream)
+  If length<0 Or length>64 Or FilePos(stream)+length>size Then valid=0 : Exit
+  SeekFile stream,FilePos(stream)+length
+ Next
+ If FilePos(stream)<>size Then valid=0
+ CloseFile stream
+ Return valid
+End Function
+
+Function NativeRecoverOptions()
+ If NativeValidOptions("Data/Options.dat") Then Return 1
+ nativeSettingsRecovered=1
+ If FileType("Data/Options.dat")=1 Then CopyFile "Data/Options.dat","Data/Options.corrupt.dat"
+ If NativeValidOptions("Data/Options.dat.bak")
+  CopyFile "Data/Options.dat.bak","Data/Options.dat"
+  Return 1
+ EndIf
+ If NativeValidOptions("Data.previous/Options.dat")
+  CopyFile "Data.previous/Options.dat","Data/Options.dat"
+  Return 1
+ EndIf
+ ; Retain discoverable slots even if both settings copies are damaged.
+ Local n,stream,character,path$
+ For n=1 To 3
+  path$="Data/Slot0"+n+"/Progress.dat"
+  If FileSize(path$)>100
+   stream=ReadFile(path$)
+   If stream
+    ReadInt(stream) : character=ReadInt(stream) : CloseFile stream
+    If character>=1 And character<=200 Then gamName$(n)="Recovered slot "+n
+   EndIf
+  EndIf
+ Next
+ Return 0
+End Function
+
+Function NativeReadSettings(path$)
+ Local stream,n,checksum=1213484356,valid=1,other
+ If FileSize(path$)<>84 Then Return 0
+ stream=ReadFile(path$)
+ If stream=0 Then Return 0
+ If ReadInt(stream)<>1213484356 Or ReadInt(stream)<>1 Then CloseFile stream : Return 0
+ For n=1 To 18
+  nativeSetting(n)=ReadInt(stream)
+  checksum=checksum Xor nativeSetting(n)
+ Next
+ If ReadInt(stream)<>checksum Then valid=0
+ CloseFile stream
+ If nativeSetting(1)<1 Or nativeSetting(1)>9 Then valid=0
+ If nativeSetting(2)<0 Or nativeSetting(2)>1 Then valid=0
+ If nativeSetting(3)<75 Or nativeSetting(3)>125 Then valid=0
+ If nativeSetting(4)<25 Or nativeSetting(4)>300 Then valid=0
+ If nativeSetting(5)<50 Or nativeSetting(5)>150 Then valid=0
+ If nativeSetting(6)<0 Or nativeSetting(6)>1 Then valid=0
+ For n=7 To 9
+  If nativeSetting(n)<0 Or nativeSetting(n)>100 Then valid=0
+ Next
+ For n=10 To 18
+  If NativeValidKey(nativeSetting(n))=0 Then valid=0
+  For other=10 To n-1
+   If nativeSetting(n)=nativeSetting(other) Then valid=0
+  Next
+ Next
+ Return valid
+End Function
+
+Function NativeLoadSettings()
+ nativeKey(5)=keyAttack : nativeKey(6)=keyDefend : nativeKey(7)=keyThrow : nativeKey(8)=keyPickUp
+ Local valid=NativeReadSettings("Data/NativeOptions.dat"),n
+ If valid=0
+  If FileType("Data/NativeOptions.dat")=1
+   nativeSettingsRecovered=1
+   CopyFile "Data/NativeOptions.dat","Data/NativeOptions.corrupt.dat"
+  EndIf
+  valid=NativeReadSettings("Data/NativeOptions.dat.bak")
+  If valid Then CopyFile "Data/NativeOptions.dat.bak","Data/NativeOptions.dat"
+ EndIf
+ If valid
+  optRes=nativeSetting(1) : nativeBorderless=nativeSetting(2) : nativeHud=nativeSetting(3)
+  nativeSensitivity=nativeSetting(4) : nativeDistance=nativeSetting(5) : nativeAutoPause=nativeSetting(6)
+  nativeMusic=nativeSetting(7) : nativeEffects=nativeSetting(8) : nativeAmbience=nativeSetting(9)
+  For n=1 To 9 : nativeKey(n)=nativeSetting(n+9) : Next
+ EndIf
+ NativeSyncKeys() : NativeApplyAudio()
+End Function
+
+Function NativeSaveSettings()
+ Local stream,n,checksum=1213484356
+ nativeSetting(1)=optRes : nativeSetting(2)=nativeBorderless : nativeSetting(3)=nativeHud
+ nativeSetting(4)=nativeSensitivity : nativeSetting(5)=nativeDistance : nativeSetting(6)=nativeAutoPause
+ nativeSetting(7)=nativeMusic : nativeSetting(8)=nativeEffects : nativeSetting(9)=nativeAmbience
+ For n=1 To 9 : nativeSetting(n+9)=nativeKey(n) : Next
+ stream=WriteFileAtomic("Data/NativeOptions.dat")
+ WriteInt stream,1213484356 : WriteInt stream,1
+ For n=1 To 18
+  WriteInt stream,nativeSetting(n) : checksum=checksum Xor nativeSetting(n)
+ Next
+ WriteInt stream,checksum : CloseFile stream
+End Function
+
+Function NativeApplyAudio()
+ AudioGroupVolume 0,nativeEffects/100.0
+ AudioGroupVolume 1,nativeMusic/100.0
+ AudioGroupVolume 2,nativeAmbience/100.0
+ ; The alarm's base gain remains zero, independently of all category sliders.
+ SoundVolume sAlarm,0
+End Function
+
