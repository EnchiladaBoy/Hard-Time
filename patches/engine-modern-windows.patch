+#pragma once
+#include <SDL.h>
+#include <bb/input/driver.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+class SDLJoystick : public BBDevice{
+public:
+    SDL_Joystick *js=nullptr;
+    ~SDLJoystick(){ if(js) SDL_JoystickClose(js); }
+    void detach(){ if(js) SDL_JoystickClose(js);js=nullptr;reset(); }
+    void attach(SDL_Joystick *device){
+        js=device;reset();
+        SDL_JoystickGetGUIDString(SDL_JoystickGetGUID(js),id,sizeof(id));
+        snprintf(name,sizeof(name),"%s",SDL_JoystickName(js));
+    }
+    void update(){
+        bbRuntimeIdle();
+        if(!js || !SDL_JoystickGetAttached(js)){ reset();return; }
+        SDL_JoystickUpdate();
+        int axes=std::min(32,SDL_JoystickNumAxes(js));
+        for(int i=0;i<axes;++i){
+            int value=SDL_JoystickGetAxis(js,i);
+            axis_states[i]=float(value)/(value<0?32768.0f:32767.0f);
+        }
+        int buttons=std::min(255,SDL_JoystickNumButtons(js));
+        for(int i=0;i<buttons;++i) setDownState(i+1,SDL_JoystickGetButton(js,i));
+    }
+};
+
+class SDLInputDriver : public BBInputDriver{
+    // A callback can disconnect the device whose update() is running.
+    // Keep wrapper addresses alive until driver destruction.
+    std::vector<SDLJoystick*> pool,active;
+public:
+    SDLInputDriver(){ refresh(); }
+    ~SDLInputDriver(){ for(auto joystick:pool) delete joystick; }
+    void refresh(){
+        for(auto joystick:pool) if(joystick->js && !SDL_JoystickGetAttached(joystick->js)) joystick->detach();
+        active.clear();
+        for(int i=0;i<SDL_NumJoysticks();++i){
+            SDL_JoystickID instance=SDL_JoystickGetDeviceInstanceID(i);
+            SDLJoystick *device=nullptr;
+            for(auto candidate:pool) if(candidate->js && SDL_JoystickInstanceID(candidate->js)==instance) device=candidate;
+            if(!device){
+                SDL_Joystick *opened=SDL_JoystickOpen(i);if(!opened) continue;
+                for(auto candidate:pool) if(!candidate->js){ device=candidate;break; }
+                if(!device){ device=new SDLJoystick();pool.push_back(device); }
+                device->attach(opened);
+            }
+            active.push_back(device);
+        }
+    }
+    BBDevice *getJoystick(int port)const{ return port>=0 && port<active.size()?active[port]:nullptr; }
+    int getJoystickType(int port)const{ return getJoystick(port)?1:0; }
+    int numJoysticks()const{ return active.size(); }
+    int toAscii(int code)const{ return code&0xff; }
+};
