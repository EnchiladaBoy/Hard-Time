+            std::vector<unsigned char> bmp(font->atlas->width*font->atlas->height*4,255);
+            for(int i=0;i<font->atlas->width*font->atlas->height;++i) bmp[i*4+3]=font->atlas->bits[i];
+            glPixelStorei(GL_UNPACK_ALIGNMENT,1);
+            glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,font->atlas->width,font->atlas->height,0,GL_RGBA,GL_UNSIGNED_BYTE,bmp.data());
+            glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+        }
+    }
+    if(!font->atlas) return;
+    const auto key=std::make_pair(font,t);
+    if(res->text_cache.find(key)==res->text_cache.end()){
+        // Bound both GPU memory and the number of dynamic dialogue strings.
+        if(res->text_cache.size()>=256) res->clearText();
+        std::vector<Vertex> verts;
+        float pen=0,baseline=font->baseline*font->density;
+        float aw=font->atlas->width,ah=font->atlas->height;
+        const char *cursor=t.c_str();utf8_int32_t curr=0,prev=0;
+        while(*cursor){
+            prev=curr;cursor=utf8codepoint(cursor,&curr);
+            auto glyph=font->getChar(curr);
+            float cx=pen+glyph.bearing_x*font->density,cy=baseline-glyph.bearing_y*font->density;
+            if(prev>0) cx+=font->getKerning(prev,curr);
+            float l=glyph.x/aw,r=(glyph.x+glyph.width)/aw,top=glyph.y/ah,b=(glyph.y+glyph.height)/ah;
