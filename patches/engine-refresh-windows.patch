+void SDLGraphics::present(bool vwait){
+ const int requested=vwait ? -1 : 0;
+ if(requestedSwapInterval!=requested){
+  requestedSwapInterval=requested;
+  int result=SDL_GL_SetSwapInterval(requested);
+  if(result==-1 && vwait) result=SDL_GL_SetSwapInterval(1);
+  swapWaitAvailable=result==0 && SDL_GL_GetSwapInterval()!=0;
+  lastPresent={};
+ }
+ // Software/virtual drivers can reject both forms of vsync. Pace those
+ // explicitly, using the window's current display (60 Hz if unavailable).
+ // Flip 0 stays immediate. Hardware vsync remains responsible for pacing.
+ if(vwait && !swapWaitAvailable){
+  SDL_DisplayMode mode{};
+  const int display=SDL_GetWindowDisplayIndex(wnd);
+  const int hz=display>=0 && SDL_GetCurrentDisplayMode(display,&mode)==0 && mode.refresh_rate>1
+      ? mode.refresh_rate : 60;
+  const auto period=std::chrono::nanoseconds(1000000000LL/hz);
+  const auto now=std::chrono::steady_clock::now();
+  auto deadline=lastPresent+period;
+  if(lastPresent==std::chrono::steady_clock::time_point{} || now-deadline>period) deadline=now;
+  std::this_thread::sleep_until(deadline);
+  // Retain the schedule so sleep overshoot does not accumulate every frame.
+  lastPresent=deadline;
+ }else{
+  lastPresent={};
+ }
+ swap();
 }
 
