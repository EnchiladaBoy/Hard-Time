 	return lower(s);
 #else
 	replace( s.begin(),s.end(),'\\','/' );
+#ifdef BB_LINUX
+	// Original Windows assets contain mixed-case extensions and references.
+	// Resolve missing components without adding aliases to directory listings.
+	namespace fs=std::filesystem;
+	std::error_code ec;
+	if( fs::exists(fs::path(s),ec) ) return s;
+	fs::path resolved;
+	for( const auto &component: fs::path(s) ){
+		fs::path exact=resolved/component;
+		ec.clear();
+		if( fs::exists(exact,ec) || component=="." || component==".." ){
+			resolved=exact;
+			continue;
+		}
+		const std::string wanted=tolower(component.string());
+		bool found=false;
+		ec.clear();
+		fs::directory_iterator it(resolved.empty()?fs::path("."):resolved,ec), end;
+		for( ; !ec && it!=end; it.increment(ec) ){
+			if( tolower(it->path().filename().string())==wanted ){
+				resolved=it->path(); found=true; break;
+			}
+		}
+		if( !found ) resolved=exact;
+	}
+	return resolved.string();
+#else
 	return s;
 #endif
+#endif
 }
 
