+; Modern display, controls and settings menus.
+Include "NativePreferences.bb"
+
+Function NativeBeginUI(extra#=1.0)
+ Local scale#=GraphicsWidth()/800.0
+ If GraphicsHeight()/600.0<scale# Then scale#=GraphicsHeight()/600.0
+ scale#=scale#*extra#
+ nativeUi=1
+ DrawTransform scale#,scale#,(GraphicsWidth()-800*scale#)/2,(GraphicsHeight()-600*scale#)/2
+End Function
+
+Function NativeBeginHUD(anchorX#,anchorY#)
+ Local scale#=GraphicsWidth()/800.0,extra#=nativeHud/100.0
+ If GraphicsHeight()/600.0<scale# Then scale#=GraphicsHeight()/600.0
+ nativeUi=1
+ DrawTransform scale#*extra#,scale#*extra#,(GraphicsWidth()-800*scale#)/2+anchorX#*scale#*(1-extra#),(GraphicsHeight()-600*scale#)/2+anchorY#*scale#*(1-extra#)
+End Function
+
+Function NativeEndUI()
+ nativeUi=0 : DrawTransform 1,1,0,0
+End Function
+
+Function NativeDrawWorld()
+ Local started=MilliSecs()
+ RenderWorld nativeTween#
+ If nativeFpsLog Then nativeRenderMs=nativeRenderMs+MilliSecs()-started
+ nativeUiStart=MilliSecs()
+End Function
+
+Function NativeRender()
+ If nativeFpsLog Then nativeLogicMs=nativeLogicMs+MilliSecs()-nativeLogicStart
+ NativeDrawWorld()
+ BeginOverlay
+ NativeBeginUI()
+End Function
+
+Function NativePresent()
+ EndOverlay
+ NativeEndUI()
+ Local started=MilliSecs()
+ If nativeFpsLog Then nativeUiMs=nativeUiMs+started-nativeUiStart
+ Flip
+ If nativeFpsLog Then nativePresentMs=nativePresentMs+MilliSecs()-started
+ NativeFrameStats(0)
+ If KeyHit(88) Then Screenshot()
+End Function
+
+Function NativeConfirm(message$,detail$,seconds=0)
+ Local dialogTimer=CreateTimer(30),choice=0,done=0,accepted=0,elapsed,start=MilliSecs(),oldFocus=foc,previousAxis=0,axis
+ ClearOverlay : FlushKeys : FlushJoy
+ While done=0
+  NativeWaitTimer(dialogTimer)
+  If AppCloseRequested() Then nativeQuit=1 : go=-1 : done=1
+  elapsed=MilliSecs()-start
+  If seconds>0 And elapsed>=seconds*1000 Then done=1
+  If elapsed>350
+   axis=JoyXDir()
+   If KeyHit(203) Or KeyHit(205) Or (axis<>0 And previousAxis=0) Then choice=1-choice
+   previousAxis=axis
+   If KeyHit(1) Then done=1
+   If KeyHit(28) Or JoyHit(buttAttack) Then accepted=choice : done=1
+  EndIf
+  Cls : NativeRender() : TileImage gTile
+  SetFont font(3) : Outline(message$,400,200,0,0,0,255,255,255)
+  SetFont font(1) : Outline(detail$,400,245,0,0,0,230,230,230)
+  foc=choice
+  DrawOption(0,275,330,"CANCEL","") : DrawOption(1,525,330,"CONFIRM","")
+  If seconds>0 Then Outline("Reverting in "+(seconds-elapsed/1000)+" seconds",400,390,0,0,0,255,220,120)
+  NativePresent()
+ Wend
+ FreeTimer dialogTimer : foc=oldFocus : ClearOverlay : FlushKeys : FlushJoy
+ nativeDiscardTicks=1
+ If nativeQuit Then Return 0
+ Return accepted
+End Function
+
+Function NativeDisplayApply()
+ Local previousRes=nativeAppliedRes,previousMode=nativeAppliedMode
+ ChangeResolution(optRes,1)
+ If NativeConfirm("Keep this display mode?","Left / right to choose, Enter to confirm",15)=0
+  optRes=previousRes : nativeBorderless=previousMode
+  ChangeResolution(optRes,1)
+ EndIf
+ SaveOptions()
+End Function
+
+Function NativeSettingsMenu()
+ Local page=1,choiceTimer=CreateTimer(30),direction,label$,value$,row
+ foc=1 : go=0 : keytim=15
+ ClearOverlay
+ While go=0
+  frames=NativeWaitTimer(choiceTimer)
+  For framer=1 To frames
+   CaptureWorld : keytim=NativeClamp(keytim-1,0,20)
+   If keytim=0
+    If KeyDown(1) Then go=-1
+    If KeyDown(200) Or JoyYDir()=-1 Then foc=foc-1 : keytim=6
+    If KeyDown(208) Or JoyYDir()=1 Then foc=foc+1 : keytim=6
+    foc=NativeClamp(foc,1,8)
+    direction=0
+    If KeyDown(203) Or JoyXDir()=-1 Then direction=-1
+    If KeyDown(205) Or JoyXDir()=1 Then direction=1
+    If direction<>0
+     keytim=6
+     If foc=1 Then page=NativeClamp(page+direction,1,3)
+     If page=1
+      If foc=2 Then optRes=NativeClamp(optRes+direction,1,9)
+      If foc=3 Then nativeBorderless=1-nativeBorderless
+      If foc=4 Then nativeHud=NativeClamp(nativeHud+direction*5,75,125)
+     EndIf
+     If page=2
+      If foc=2 Then nativeSensitivity=NativeClamp(nativeSensitivity+direction*25,25,300)
+      If foc=3 Then nativeDistance=NativeClamp(nativeDistance+direction*10,50,150)
+      If foc=4 Then nativeAutoPause=1-nativeAutoPause
+     EndIf
+     If page=3
+      If foc=2 Then nativeMusic=NativeClamp(nativeMusic+direction*5,0,100)
+      If foc=3 Then nativeEffects=NativeClamp(nativeEffects+direction*5,0,100)
+      If foc=4 Then nativeAmbience=NativeClamp(nativeAmbience+direction*5,0,100)
+      NativeApplyAudio()
+     EndIf
+    EndIf
+    If KeyDown(28) Or ButtonPressed()
+     keytim=15
+     If foc=8 Then go=-1
+     If page=2 And foc=5 Then NativeKeyPreset(1) : PlaySound sMenuSelect
+     If page=2 And foc=6 Then go=1
+     If foc=7
+      If page=1
+       NativeDisplayApply()
+      Else
+       SaveOptions()
+      EndIf
+     EndIf
+    EndIf
+   EndIf
+  Next
+  Cls : NativeRender() : TileImage gTile
+  SetFont font(3) : Outline("MODERN SETTINGS",400,48,0,0,0,255,255,255)
+  label$="Display" : If page=2 Then label$="Controls / camera"
+  If page=3 Then label$="Audio"
+  DrawOption(1,400,110,"PAGE",label$)
+  If page=1
+   DrawOption(2,400,165,"Resolution",NativeResolutionName$(optRes))
+   value$="Windowed" : If nativeBorderless Then value$="Borderless desktop"
+   DrawOption(3,400,220,"Window mode",value$)
+   DrawOption(4,400,275,"HUD size",nativeHud+"%")
+   SetFont font(1)
+   Outline("Borderless uses your desktop resolution.",400,330,0,0,0,230,230,230)
+   Outline("Display changes have a 15-second revert timer.",400,365,0,0,0,230,230,230)
+  EndIf
+  If page=2
+   DrawOption(2,400,165,"Mouse sensitivity",nativeSensitivity+"%")
+   DrawOption(3,400,220,"Camera distance",nativeDistance+"%")
+   DrawOption(4,400,275,"Pause on focus loss",textOnOff$(nativeAutoPause))
+   DrawOption(5,400,330,"USE WASD PRESET","")
+   DrawOption(6,400,385,"REMAP ALL KEYS","")
+  EndIf
+  If page=3
+   DrawOption(2,400,165,"Music",nativeMusic+"%")
+   DrawOption(3,400,220,"Sound effects",nativeEffects+"%")
+   DrawOption(4,400,275,"Ambience",nativeAmbience+"%")
+   SetFont font(1) : Outline("Alarm sound: disabled",400,350,0,0,0,230,230,230)
+  EndIf
+  DrawOption(7,400,440,"APPLY / SAVE","") : DrawOption(8,400,500,"<<< BACK <<<","")
+  SetFont font(1) : Outline("Up / down: select   Left / right: change   Enter: apply",400,555,0,0,0,230,230,230)
+  NativePresent()
+ Wend
+ FreeTimer choiceTimer
+ optRes=nativeAppliedRes : nativeBorderless=nativeAppliedMode
+ SaveOptions()
+ If go=1 Then screen=3 Else screen=2
+End Function
+
+Function NativeResolutionName$(res)
+ If res=6 Then Return "Desktop ("+DesktopWidth()+" x "+DesktopHeight()+")"
+ Return textResX$(res)+" x "+textResY$(res)
+End Function
+
+Function NativeKeyboardMenu()
+ Local choiceTimer=CreateTimer(30),binding=0,pressed,n,previous,label$
+ foc=1 : go=0 : keytim=15 : ClearOverlay
+ While go=0
+  frames=NativeWaitTimer(choiceTimer)
+  For framer=1 To frames
+   CaptureWorld : keytim=NativeClamp(keytim-1,0,20)
+   If binding>0
+    If KeyHit(1) Then binding=0 : keytim=15
+    If keytim=0 And binding>0
+     For pressed=2 To 211
+      If NativeValidKey(pressed) And KeyHit(pressed)
+       previous=nativeKey(binding)
+       For n=1 To 9
+        If nativeKey(n)=pressed Then nativeKey(n)=previous
+       Next
+       nativeKey(binding)=pressed : NativeSyncKeys()
+       binding=0 : keytim=15 : Exit
+      EndIf
+     Next
+    EndIf
+   Else
+    If keytim=0
+     If KeyDown(1) Then go=-1
+     If KeyDown(200) Or JoyYDir()=-1 Then foc=foc-1 : keytim=5
+     If KeyDown(208) Or JoyYDir()=1 Then foc=foc+1 : keytim=5
+     foc=NativeClamp(foc,1,12)
+     If KeyDown(28) Or ButtonPressed()
+      keytim=15 : FlushKeys
+      If foc<=9 Then binding=foc
+      If foc=10 Then NativeKeyPreset(0)
+      If foc=11 Then NativeKeyPreset(1)
+      If foc=12 Then go=-1
+     EndIf
+    EndIf
+   EndIf
+  Next
+  Cls : NativeRender() : TileImage gTile
+  SetFont font(3) : Outline("KEYBOARD CONTROLS",400,38,0,0,0,255,255,255)
+  For n=1 To 12
+   If foc=n Then Color 45,75,100 : Rect 190,66+(n-1)*38,420,34,1
+   SetFont font(2)
+   If n<=9
+    label$=Key$(nativeKey(n)) : If label$="" Then label$="Key "+nativeKey(n)
+    If binding=n Then label$="Press a key..."
+    OutlineStraight(nativeKeyName$(n),205,83+(n-1)*38,0,0,0,255,255,255)
+    Outline(label$,510,83+(n-1)*38,0,0,0,255,255,255)
+   Else
+    label$="Original controls" : If n=11 Then label$="WASD + J / K / L / E"
+    If n=12 Then label$="<<< BACK <<<"
+    Outline(label$,400,83+(n-1)*38,0,0,0,255,255,255)
+   EndIf
+  Next
+  SetFont font(1) : Outline("Enter: rebind   Esc: cancel   Duplicate keys swap assignments",400,555,0,0,0,230,230,230)
+  NativePresent()
+ Wend
+ FreeTimer choiceTimer : SaveOptions() : screen=2
+End Function
