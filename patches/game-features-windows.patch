+; Shared Options / pause menus. Pause callers restore the outer loop counters.
+Function NativeUtilityMenu(page)
+ Local menuTimer=CreateTimer(30),direction,limit=7,title$,help$
+ foc=1 : go=0 : keytim=15 : ClearOverlay
+ If page=2 Then limit=5
+ While go=0
+  frames=NativeWaitTimer(menuTimer)
+  For framer=1 To frames
+   CaptureWorld : keytim=NativeClamp(keytim-1,0,20)
+   If keytim=0
+    If KeyDown(1) Then go=-1
+    If KeyDown(200) Or JoyYDir()=-1 Then foc=foc-1 : keytim=6
+    If KeyDown(208) Or JoyYDir()=1 Then foc=foc+1 : keytim=6
+    foc=NativeClamp(foc,1,limit)
+    direction=0
+    If KeyDown(203) Or JoyXDir()=-1 Then direction=-1
+    If KeyDown(205) Or JoyXDir()=1 Then direction=1
+    If KeyDown(28) Or ButtonPressed()
+     If foc=limit Then go=-1
+     If foc=limit-1
+      If page=1 Then nativeMaster=100 : nativeMute=0 : nativeMusic=100 : nativeEffects=100 : nativeAmbience=100
+      If page=2 Then nativeLimbPunch=0 : nativeGodMode=0 : nativeSuperPunch=0
+     Else
+      direction=1
+     EndIf
+     keytim=15
+    EndIf
+    If direction<>0
+     If keytim=0 Then keytim=6
+     If page=1
+      If foc=1 Then nativeMaster=NativeClamp(nativeMaster+direction*5,0,100)
+      If foc=2 Then nativeMusic=NativeClamp(nativeMusic+direction*5,0,100)
+      If foc=3 Then nativeEffects=NativeClamp(nativeEffects+direction*5,0,100)
+      If foc=4 Then nativeAmbience=NativeClamp(nativeAmbience+direction*5,0,100)
+      If foc=5 Then nativeMute=1-nativeMute
+     Else
+      If foc=1 Then nativeLimbPunch=1-nativeLimbPunch
+      If foc=2 Then nativeGodMode=1-nativeGodMode
+      If foc=3 Then nativeSuperPunch=1-nativeSuperPunch
+     EndIf
+    EndIf
+    NativeApplyAudio()
+   EndIf
+  Next
+  Cls : NativeRender() : TileImage gTile
+  title$="AUDIO SETTINGS" : If page=2 Then title$="CHEATS"
+  SetFont font(3) : Outline(title$,400,50,0,0,0,255,255,255)
+  If page=1
+   DrawOption(1,400,120,"Master volume",nativeMaster+"%")
+   DrawOption(2,400,175,"Music",nativeMusic+"%")
+   DrawOption(3,400,230,"Sound effects",nativeEffects+"%")
+   DrawOption(4,400,285,"Ambience",nativeAmbience+"%")
+   DrawOption(5,400,340,"Mute all",textOnOff$(nativeMute))
+   DrawOption(6,400,410,"RESET AUDIO","")
+   SetFont font(1) : Outline("Changes apply immediately. The alarm stays silent.",400,550,0,0,0,230,230,230)
+  Else
+   DrawOption(1,400,130,"Limb breaker",textOnOff$(nativeLimbPunch))
+   DrawOption(2,400,190,"Invincible player",textOnOff$(nativeGodMode))
+   DrawOption(3,400,250,"Super knockback",textOnOff$(nativeSuperPunch))
+   DrawOption(4,400,410,"DISABLE ALL","")
+   SetFont font(1)
+   help$="Unarmed hits remove limbs. Living NPCs survive while enabled."
+   If foc=2 Then help$="Prevents new injuries and keeps your health full."
+   If foc=3 Then help$="Unblocked unarmed hits send opponents stumbling."
+   Outline(help$,400,320,0,0,0,255,220,150)
+   Outline("Limb loss is saved. Turning cheats off does not restore limbs.",400,355,0,0,0,230,230,230)
+   Outline("Use a separate save slot for experiments.",400,550,0,0,0,230,230,230)
