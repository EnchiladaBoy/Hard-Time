+static OpenALChannel *playSample(const std::shared_ptr<OpenALSample>& sample,bool spatial,bool loop,int pitch,float volume,float pan,const float *pos=0,const float *vel=0){
+    OpenALChannel *channel=0;
+    // Match the original driver's reusable channel handles. Paused channels
+    // remain allocated; completed channels can be used by the next sound.
+    for(auto c:channels) if(!c->isPlaying()){ channel=c; break; }
+    if(!channel){ channel=new OpenALChannel(); channels.push_back(channel); }
+    if(!channel->prepare(sample,spatial,loop,pitch,volume,pan)) return 0;
+    if(spatial&&pos&&vel) channel->set3d(pos,vel);
+    channel->play();
+    return channel;
