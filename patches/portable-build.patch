-  execute_process(COMMAND gcc --print-file-name= OUTPUT_VARIABLE LIBGCC_DIR OUTPUT_STRIP_TRAILING_WHITESPACE)
-
-  target_compile_definitions(blitzcc PRIVATE LIBARCH_DIR="${LIBARCH_DIR}" LIBGCC_DIR="${LIBGCC_DIR}")
+  # Query the selected compiler, respecting an optional local toolchain.
+  execute_process(COMMAND ${CMAKE_C_COMPILER} --print-file-name=crt1.o
+    OUTPUT_VARIABLE BB_CRT1 OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+  execute_process(COMMAND ${CMAKE_C_COMPILER} --print-file-name=crtbeginT.o
+    OUTPUT_VARIABLE BB_CRTBEGIN OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+  if(NOT IS_ABSOLUTE "${BB_CRT1}" OR NOT EXISTS "${BB_CRT1}" OR
+     NOT IS_ABSOLUTE "${BB_CRTBEGIN}" OR NOT EXISTS "${BB_CRTBEGIN}")
+    message(FATAL_ERROR "GCC must locate the glibc and GCC development startup objects")
+  endif()
+  get_filename_component(BB_CRT_DIR "${BB_CRT1}" DIRECTORY)
+  get_filename_component(BB_GCC_DIR "${BB_CRTBEGIN}" DIRECTORY)
+  set(LIBARCH_DIR "${BB_CRT_DIR}" CACHE PATH "glibc startup object directory")
+  set(LIBGCC_DIR "${BB_GCC_DIR}" CACHE PATH "GCC startup object directory")
+  set(BB_DYNAMIC_LINKER "/lib/ld-linux-aarch64.so.1" CACHE FILEPATH "ARM64 glibc loader")
+  if(NOT EXISTS "${BB_DYNAMIC_LINKER}")
+    message(FATAL_ERROR "ARM64 glibc loader missing; override BB_DYNAMIC_LINKER if required")
+  endif()
+  target_compile_definitions(blitzcc PRIVATE LIBARCH_DIR="${LIBARCH_DIR}" LIBGCC_DIR="${LIBGCC_DIR}" BB_DYNAMIC_LINKER="${BB_DYNAMIC_LINKER}")
 endif()
 
 target_include_directories(blitzcc PRIVATE ../src/runtime)
