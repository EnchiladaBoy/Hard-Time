+; Versioned extension: keep NativeOptions.dat readable by existing builds.
+Global nativeMaster=100,nativeMute=0
+Global nativeLimbPunch=0,nativeGodMode=0,nativeSuperPunch=0
+Dim nativeExtra(5)
+
+Function NativeReadExtras(path$)
+ Local stream,n,checksum=1213484357,valid=1
+ If FileSize(path$)<>32 Then Return 0
+ stream=ReadFile(path$)
+ If stream=0 Then Return 0
+ If ReadInt(stream)<>1213484357 Or ReadInt(stream)<>1 Then CloseFile stream : Return 0
+ For n=1 To 5
+  nativeExtra(n)=ReadInt(stream) : checksum=checksum Xor nativeExtra(n)
+ Next
+ If ReadInt(stream)<>checksum Then valid=0
+ CloseFile stream
+ If nativeExtra(1)<0 Or nativeExtra(1)>100 Then valid=0
+ For n=2 To 5
+  If nativeExtra(n)<0 Or nativeExtra(n)>1 Then valid=0
+ Next
+ Return valid
+End Function
+
+Function NativeLoadExtras()
+ Local valid=NativeReadExtras("Data/NativeExtras.dat")
+ nativeMaster=100 : nativeMute=0 : nativeLimbPunch=0 : nativeGodMode=0 : nativeSuperPunch=0
+ If valid=0
+  If FileType("Data/NativeExtras.dat")=1 Then CopyFile "Data/NativeExtras.dat","Data/NativeExtras.corrupt.dat"
+  valid=NativeReadExtras("Data/NativeExtras.dat.bak")
+  If valid Then CopyFile "Data/NativeExtras.dat.bak","Data/NativeExtras.dat"
+ EndIf
+ If valid
+  nativeMaster=nativeExtra(1) : nativeMute=nativeExtra(2)
+  nativeLimbPunch=nativeExtra(3) : nativeGodMode=nativeExtra(4) : nativeSuperPunch=nativeExtra(5)
+ EndIf
+End Function
+
+Function NativeSaveExtras()
+ Local stream,n,checksum=1213484357
+ nativeExtra(1)=nativeMaster : nativeExtra(2)=nativeMute
+ nativeExtra(3)=nativeLimbPunch : nativeExtra(4)=nativeGodMode : nativeExtra(5)=nativeSuperPunch
+ stream=WriteFileAtomic("Data/NativeExtras.dat")
+ WriteInt stream,1213484357 : WriteInt stream,1
+ For n=1 To 5
+  WriteInt stream,nativeExtra(n) : checksum=checksum Xor nativeExtra(n)
+ Next
+ WriteInt stream,checksum : CloseFile stream
+End Function
