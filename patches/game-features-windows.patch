+; Edge-to-edge bars, with subtitles retained in the centered logical UI.
+Function NativeDialogueBars(ticks)
+ Local scale#=GraphicsWidth()/800.0,amount#=1.0,margin#,top,bottom
+ If GraphicsHeight()/600.0<scale# Then scale#=GraphicsHeight()/600.0
+ If ticks<25 Then amount#=ticks/25.0
+ If ticks>9975 Then amount#=(10000-ticks)/25.0
+ If amount#<0 Then amount#=0
+ margin#=(GraphicsHeight()-600*scale#)/2
+ top=Ceil((margin#+60*scale#)*amount#)
+ bottom=Ceil((margin#+120*scale#)*amount#)
+ DrawTransform 1,1,0,0
+ Color 0,0,0
+ If top>0 Then Rect 0,0,GraphicsWidth(),top,1
+ If bottom>0 Then Rect 0,GraphicsHeight()-bottom,GraphicsWidth(),bottom,1
+ DrawTransform scale#,scale#,(GraphicsWidth()-800*scale#)/2,margin#
+End Function
--- /dev/null
+++ b/NativeCheats.bb
@@ -0,0 +1,113 @@
+; Cheats only affect the player's attacks. Existing corpses are never revived.
+Dim nativeLiving(200)
+Dim nativeDebris(24),nativeDebrisLife(24)
+Dim nativeDebrisX#(24),nativeDebrisY#(24),nativeDebrisZ#(24),nativeDebrisFloor#(24)
+Global nativeDebrisNext=0,nativePauseChoice=1
+
+Function NativeInvincible(cyc)
+ If nativeGodMode=0 Or cyc<1 Or cyc>no_plays Then Return 0
+ Return pChar(cyc)=gamChar(slot) And nativeLiving(cyc)
+End Function
+
+Function NativeProtectPlayer(cyc)
+ If nativeLiving(cyc)=0 Then Return
+ If NativeInvincible(cyc)
+  pHealth(cyc)=100 : pInjured(cyc)=0 : pDazed(cyc)=0
+  charInjured(pChar(cyc))=0
+  If pHP(cyc)<10 Then pHP(cyc)=10
+ Else
+  If nativeLimbPunch=0 Or pChar(cyc)=gamChar(slot)
+   If pHealth(cyc)<=0 And (pAnim(cyc)=76 Or pAnim(cyc)=77) And pAnimTim(cyc)>=150 Then nativeLiving(cyc)=0
+   Return
+  EndIf
+  ; Preserve the original knockdown/disability mechanics, but stop fatal damage.
+  If pHealth(cyc)<25 Then pHealth(cyc)=25
+ EndIf
+ charHealth(pChar(cyc))=pHealth(cyc)
+ If pAnim(cyc)=76 Then ChangeAnim(cyc,82)
+ If pAnim(cyc)=77 Then ChangeAnim(cyc,85)
+End Function
+
+Function NativeBranch(limb,root)
+ Local parent=limb,steps=0
+ While parent>0 And steps<40
+  If parent=root Then Return 1
+  parent=limbSource(parent) : steps=steps+1
+ Wend
+ Return 0
+End Function
+
+Function NativeThrowLimb(cyc,root,angle#)
+ Local n,entity,scale#=0.34+charHeight(pChar(cyc))*0.0025
+ nativeDebrisNext=nativeDebrisNext Mod 24+1 : n=nativeDebrisNext
+ If nativeDebris(n)>0 Then FreeEntity nativeDebris(n)
+ entity=CopyEntity(pLimb(cyc,root))
+ nativeDebris(n)=entity : nativeDebrisLife(n)=90
+ EntityType entity,0,True
+ PositionEntity entity,EntityX(pLimb(cyc,root),1),EntityY(pLimb(cyc,root),1),EntityZ(pLimb(cyc,root),1)
+ RotateEntity entity,EntityPitch(pLimb(cyc,root),1),EntityYaw(pLimb(cyc,root),1),EntityRoll(pLimb(cyc,root),1)
+ ScaleEntity entity,scale#,scale#,scale#
+ nativeDebrisX#(n)=Sin(angle#)*2.5 : nativeDebrisY#(n)=3.0 : nativeDebrisZ#(n)=Cos(angle#)*2.5
+ nativeDebrisFloor#(n)=pGround#(cyc)+1
+ ShowEntity entity
+End Function
+
+Function NativeMeleeHit(attacker,target,blocked)
+ If nativeLimbPunch=0 And nativeSuperPunch=0 Then Return
+ If attacker<1 Or target<1 Or attacker>no_plays Or target>no_plays Or attacker=target Then Return
+ If pChar(attacker)<>gamChar(slot) Or pWeapon(attacker)>0 Or blocked Then Return
+ If nativeLiving(target)=0 Then Return
+ Local root=0,limb
+ If nativeLimbPunch
+  ; One whole arm/leg per landed hit; never detach the head or torso.
+  If pScar(target,4)<5 And pLimb(target,4)>0 Then root=4
+  If root=0 And pScar(target,17)<5 And pLimb(target,17)>0 Then root=17
+  If root=0 And pScar(target,31)<5 And pLimb(target,31)>0 Then root=31
+  If root=0 And pScar(target,34)<5 And pLimb(target,34)>0 Then root=34
+  If root>0
+   NativeThrowLimb(target,root,pA#(attacker))
+   LoseLimb(target,root,0,1)
+   For limb=4 To 36
+    If NativeBranch(limb,root)
+     pScar(target,limb)=5
+     If pLimb(target,limb)>0 Then HideEntity pLimb(target,limb)
+    EndIf
+   Next
+  EndIf
+  NativeProtectPlayer(target)
+ EndIf
+ If nativeSuperPunch Then pStagger#(target)=6.0
+End Function
+
+Function NativeUpdateCheats()
+ Local n,entity,y#
+ For n=1 To no_plays : NativeProtectPlayer(n) : Next
+ For n=1 To 24
+  entity=nativeDebris(n)
+  If entity>0
+   nativeDebrisLife(n)=nativeDebrisLife(n)-1
+   If nativeDebrisLife(n)<=0
+    FreeEntity entity : nativeDebris(n)=0
+   Else
+    y#=EntityY(entity)+nativeDebrisY#(n)
+    If y#<nativeDebrisFloor#(n)
+     y#=nativeDebrisFloor#(n) : nativeDebrisY#(n)=0
+     nativeDebrisX#(n)=nativeDebrisX#(n)*0.8 : nativeDebrisZ#(n)=nativeDebrisZ#(n)*0.8
+    Else
+     nativeDebrisY#(n)=nativeDebrisY#(n)-0.18
+     TurnEntity entity,6,3,5
+    EndIf
+    PositionEntity entity,EntityX(entity)+nativeDebrisX#(n),y#,EntityZ(entity)+nativeDebrisZ#(n)
+   EndIf
+  EndIf
+ Next
+End Function
+
+Function NativeClearDebris()
+ Local n
+ For n=1 To 24
+  If nativeDebris(n)>0 Then FreeEntity nativeDebris(n)
+  nativeDebris(n)=0 : nativeDebrisLife(n)=0
+ Next
+ nativeDebrisNext=0
+End Function
