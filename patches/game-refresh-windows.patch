 ;Let every screen unwind through its normal save and cleanup path.
-Function NativeWaitTimer(timer)
- Local ticks=WaitTimer(timer)
+Function NativeWaitTimer(timer,smooth=0)
+ Local ticks
+ If smooth<>nativeSmooth Then CaptureWorld
+ nativeSmooth=smooth
+ If smooth
+  ticks=PollTimer(timer)
+  nativeTween#=TimerTween#(timer)
+ Else
+  ticks=WaitTimer(timer)
+  nativeTween#=1.0
+ EndIf
  If AppCloseRequested() Or (KeyDown(56) And KeyDown(45))
   nativeQuit=1
   go=-1
   Return 0
  EndIf
  Return ticks
+End Function
+
+;Display cadence is independent of the original 30 Hz gameplay clock.
+Function NativeFrameStats(ticks)
+ nativeFpsFrames=nativeFpsFrames+1
+ nativeFpsTicks=nativeFpsTicks+ticks
+ Local elapsed=MilliSecs()-nativeFpsStart
+ If elapsed>=2000
+  nativeFps#=1000.0*nativeFpsFrames/elapsed
+  nativeTickRate#=1000.0*nativeFpsTicks/elapsed
+  If nativeFpsLog
+   WriteLine nativeFpsLog,elapsed+","+nativeFpsFrames+","+nativeFpsTicks+","+nativeFps#+","+nativeTickRate#+","+gamLocation(slot)+","+gamPromo
+  EndIf
+  nativeFpsStart=MilliSecs()
+  nativeFpsFrames=0 : nativeFpsTicks=0
+ EndIf
 End Function
 
